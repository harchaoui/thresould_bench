```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
*.pyc.class

# Testing
.pytest_cache/
.coverage
coverage/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
```